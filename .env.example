# sol-agent-trader — environment variable names by service (blueprint §26; config/profiles/*.json).
# Copy to .env.local (gitignored) for Profile 0. Values here are blank on purpose.
# Which service may hold which name is enforced at startup by libs/contracts config/env.ts:
# a service refuses to boot if it sees a credential it must never hold.

# --- common -------------------------------------------------------------------------------------
DEPLOYMENT_PROFILE=P0
SOLANA_CLUSTER=devnet

# --- web (browser control plane; anon key only) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SENTRY_DSN_WEB=

# --- worker -------------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
PROJECTION_SIGNING_KEY_PKCS8=
PROJECTION_SIGNING_PUBLIC_KEY=
EMERGENCY_OPERATOR_PUBLIC_KEYS=
SENTRY_DSN_WORKER=
# market data (M4). Without BIRDEYE_API_KEY the market-ingest role stays off and its feeds report FAILED.
BIRDEYE_API_KEY=
BIRDEYE_TIER=STANDARD
JUPITER_API_KEY=
JUPITER_REQUESTS_PER_SECOND=1
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WORKER_ROLES=market-ingest,eligibility
ELIGIBILITY_INTERVAL_MS=300000
MARKET_INGEST_INTERVAL_MS=60000

# --- risk-authorizer (no LLM, provider or signer credentials, ever) -----------------------------
RISK_AUTHORIZATION_KEY_PKCS8=
RISK_AUTHORIZATION_PUBLIC_KEY=
PROJECTION_VERIFICATION_PUBLIC_KEYS=
RELEASE_ATTESTATION_TRUST_FINGERPRINTS=
SOLANA_RPC_ALLOWLIST=
SENTRY_DSN_RISK_AUTHORIZER=

# --- execution-service --------------------------------------------------------------------------
EXECUTOR_GUARDRAILS_JSON=
RISK_AUTHORIZER_PUBLIC_KEYS=
SOLANA_RPC_PRIMARY=
SOLANA_RPC_SIMULATION=
SIGNER_BACKEND=SOFTWARE_DEV
EXECUTOR_JOURNAL_PATH=
SENTRY_DSN_EXECUTION_SERVICE=
# Turnkey (Profile 2+ only; lives in the isolated VM, never in this workspace)
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_WALLET_ADDRESS=

# --- local Supabase (pnpm exec supabase start) --------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
