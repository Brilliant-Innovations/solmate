{
  "name": "@sol-agent-trader/execution-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/execution-service/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "main": "apps/execution-service/src/main.ts",
          "tsConfig": "apps/execution-service/tsconfig.app.json",
          "assets": [
            "apps/execution-service/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "target": "node24",
            "platform": "node",
            "banner": {
              "js": "// sol-agent-trader execution-service — self-contained bundle; no node_modules at runtime"
            }
          },
          "thirdParty": true,
          "minify": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "target": "node24",
              "platform": "node"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/execution-service/dist/package.json",
          "{workspaceRoot}/apps/execution-service/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/execution-service/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/execution-service/dist/patches",
          "{workspaceRoot}/apps/execution-service/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/execution-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@sol-agent-trader/execution-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@sol-agent-trader/execution-service:build:development"
          },
          "production": {
            "buildTarget": "@sol-agent-trader/execution-service:build:production"
          }
        }
      }
    },
    "tags": [
      "type:app",
      "trust:execution-service",
      "scope:execution-service"
    ]
  },
  "dependencies": {
    "@sol-agent-trader/contracts": "workspace:*",
    "@sol-agent-trader/observability": "workspace:*",
    "@sol-agent-trader/execution": "workspace:*",
    "@sol-agent-trader/solana-hard-state": "workspace:*",
    "@sol-agent-trader/db": "workspace:*"
  }
}
