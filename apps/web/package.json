{
  "name": "@sol-agent-trader/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.28.2",
  "nx": {
    "sourceRoot": "apps/web/src",
    "tags": [
      "type:app",
      "trust:web",
      "scope:web"
    ],
    "targets": {
      "e2e": {
        "command": "pnpm exec playwright test -c apps/web/e2e/playwright.config.ts",
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@sol-agent-trader/contracts": "workspace:*",
    "@sol-agent-trader/db": "workspace:*",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
