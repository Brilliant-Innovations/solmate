{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/observability/tsconfig.lib.json"
    },
    {
      "path": "../../libs/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/market/tsconfig.lib.json"
    },
    {
      "path": "../../libs/db/tsconfig.lib.json"
    },
    {
      "path": "../../libs/risk/tsconfig.lib.json"
    },
    {
      "path": "../../libs/solana-hard-state/tsconfig.lib.json"
    },
    {
      "path": "../../libs/execution/tsconfig.lib.json"
    },
    {
      "path": "../../libs/onchain/tsconfig.lib.json"
    },
    {
      "path": "../../libs/signals/tsconfig.lib.json"
    }
  ]
}
