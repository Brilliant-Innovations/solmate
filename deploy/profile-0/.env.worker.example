# worker credentials only (config/profiles/P0.json services.worker.credentials). Never a signer key,
# never RISK_AUTHORIZATION_KEY_PKCS8: the service refuses to boot if it sees one (libs/contracts/src/config/env.ts).
SOLANA_CLUSTER=devnet
SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres
PROJECTION_SIGNING_KEY_PKCS8=
PROJECTION_SIGNING_PUBLIC_KEY=
EMERGENCY_OPERATOR_PUBLIC_KEYS=
SENTRY_DSN_WORKER=
# market data (M4): purchased Birdeye tier sizes rate and compute-unit budgets (STANDARD|LITE|STARTER|PREMIUM|BUSINESS)
BIRDEYE_API_KEY=
BIRDEYE_TIER=STANDARD
JUPITER_API_KEY=
JUPITER_REQUESTS_PER_SECOND=1
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Second independent RPC view for the chain-health role (§14.7); without it cross-RPC divergence is not observed.
# SOLANA_RPC_SECONDARY_URL=
# CHAIN_HEALTH_INTERVAL_MS=15000
WORKER_ROLES=market-ingest,eligibility,held-asset-safety,reconciliation,tracked-wallets,features,candidates
ELIGIBILITY_INTERVAL_MS=300000
ELIGIBILITY_REEVALUATE_AFTER_MS=21600000
ELIGIBILITY_BLOCKED_REEVALUATE_AFTER_MS=86400000
HELD_ASSET_SAFETY_INTERVAL_MS=60000
RECONCILIATION_INTERVAL_MS=60000
TRACKED_WALLETS_INTERVAL_MS=120000
FEATURES_INTERVAL_MS=60000
CANDIDATES_INTERVAL_MS=60000
MARKET_INGEST_INTERVAL_MS=60000

# --- M6 agents role (Trading Skill S1, §11) --------------------------------------------------------
# Add "agents" to WORKER_ROLES to run S1 discretionary cycles. Without both provider keys the role logs
# roles_disabled and does nothing. Keys are read from this environment only (D65); never commit them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AGENT_PROPOSER_MODEL=anthropic:claude-sonnet-5
# AGENT_ADVERSARY_MODEL=openai:gpt-5
# USD per million tokens as input,output per model; unpriced models are recorded at zero cost.
# AGENT_MODEL_PRICING=anthropic:claude-sonnet-5=3,15;openai:gpt-5=1.25,10
# AGENTS_INTERVAL_MS=60000
# AGENTS_BATCH_SIZE=5
# Add "trading-actions" to WORKER_ROLES next to "agents": it executes cleared S1 REDUCE/EXIT/ADJUST_PROTECTION decisions.
# TRADING_ACTIONS_INTERVAL_MS=15000

# --- M6 intel-ingest role (§3.4–3.5, §10) -----------------------------------------------------------
# Add "intel-ingest" to WORKER_ROLES. Each key enables its provider; with neither the role logs roles_disabled.
# CRYPTOPANIC_API_KEY=
# LUNARCRUSH_API_KEY=
# INTEL_INGEST_INTERVAL_MS=300000
# CRYPTOPANIC_REQUESTS_PER_MINUTE=5
# LUNARCRUSH_REQUESTS_PER_MINUTE=10

# --- M7 state-projector role (§6.14A, D52) ------------------------------------------------------------
# Add "state-projector" to WORKER_ROLES. Signs a sequenced RiskStateProjection with PROJECTION_SIGNING_KEY_PKCS8 every interval.
# STATE_PROJECTOR_INTERVAL_MS=60000

# --- M7 live-entry and approvals roles (§15.3–15.6) ---------------------------------------------------
# Only meaningful with a LIVE trading account (Profile 2). Both roles log roles_disabled with the reason otherwise.
# RISK_AUTHORIZER_URL=http://127.0.0.1:8781
# RISK_AUTHORIZER_PUBLIC_KEYS=<hex,hex>
# APPROVAL_SIGNING_KEY_PKCS8=<hex>        # worker-exclusive; the executor pins APPROVAL_PUBLIC_KEYS
# APPROVAL_SIGNING_PUBLIC_KEY=<hex>
# LIVE_ENTRY_INTERVAL_MS=15000
# APPROVALS_INTERVAL_MS=10000
# APPROVAL_MAX_VALIDITY_MS=120000
