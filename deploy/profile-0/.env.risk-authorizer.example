# risk-authorizer credentials only (config/profiles/P0.json services.risk-authorizer.credentials).
# No service-role key, no LLM/provider key, no signer credential: the service refuses to boot if it sees one.
SOLANA_CLUSTER=devnet
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres
RISK_AUTHORIZATION_KEY_PKCS8=
RISK_AUTHORIZATION_PUBLIC_KEY=
PROJECTION_VERIFICATION_PUBLIC_KEYS=
RELEASE_ATTESTATION_TRUST_FINGERPRINTS=
SOLANA_RPC_ALLOWLIST=
SENTRY_DSN_RISK_AUTHORIZER=
# External audit-checkpoint replica the authorizer verifies clearances against (ADR-0009 P2); without it every entry is denied.
AUDIT_CHECKPOINT_PATH=

# --- internal API -----------------------------------------------------------------------------------
# Same shared secret the worker holds as INTERNAL_API_SECRET; `node tools/dev-keys.mjs` emits both from
# one value. A list, so rotation is append → restart → move the worker → drop the old one.
DEPLOYMENT_PROFILE=P0
SERVICE_INSTANCE_ID=risk-authorizer-local
INTERNAL_API_LISTEN=127.0.0.1:8781
INTERNAL_API_SECRETS=
