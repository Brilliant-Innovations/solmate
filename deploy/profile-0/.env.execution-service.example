# execution-service credentials only (config/profiles/P0.json services.execution-service.credentials).
# Profile 0/1A: SOFTWARE_DEV signer, liveCapabilityEnabled=false. Turnkey credentials never appear here (D65).
SOLANA_CLUSTER=devnet
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres
EXECUTOR_GUARDRAILS_JSON={"liveCapabilityEnabled":false}
RISK_AUTHORIZER_PUBLIC_KEYS=
EMERGENCY_OPERATOR_PUBLIC_KEYS=
SOLANA_RPC_PRIMARY=
SOLANA_RPC_SIMULATION=
# Second independent RPC view for staged finality / REORG_PENDING (§14.7). Expected in every live profile.
SOLANA_RPC_SECONDARY=
# FINALITY_TRACK_INTERVAL_MS=5000
SIGNER_BACKEND=SOFTWARE_DEV
# Required when SIGNER_BACKEND=SOFTWARE_DEV and refused for any other backend. Throwaway Ed25519
# PKCS#8 DER hex; `node tools/dev-keys.mjs` does not mint this one because it is the signer key
# rather than a control-plane key — generate it in the isolated dev shell and never reuse it.
SOFTWARE_SIGNER_KEY_PKCS8=
SENTRY_DSN_EXECUTION_SERVICE=

# --- internal API, and what it unlocks --------------------------------------------------------------
# The worker reaches the executor over loopback with a shared secret. Without these three lines the two
# executor readiness drills record FAIL:EXECUTOR_NOT_CONFIGURED, which is honest but proves nothing:
# the drill bodies never run. `node tools/dev-keys.mjs` emits INTERNAL_API_SECRETS here and the matching
# INTERNAL_API_SECRET in the worker block, so the pair always agrees.
#
# INTERNAL_API_SECRETS is a list so a rotation is: append the new value, restart this service, move the
# worker to it, then drop the old one. 64+ hex characters (libs/contracts/src/config/env.ts).
DEPLOYMENT_PROFILE=P0
SERVICE_INSTANCE_ID=execution-service-local
INTERNAL_API_LISTEN=127.0.0.1:8791
INTERNAL_API_SECRETS=
# Out-of-band kill/close listener (§15.10, D25): reachable when Postgres and the web app are not.
OUT_OF_BAND_LISTEN=127.0.0.1:8792
# Durable execution journal — persist-before-submit (D12, §6.18) depends on it surviving a crash, so
# put it on real disk, not tmp. The container route mounts the named volume `executor-journal` here.
EXECUTOR_JOURNAL_PATH=./.executor-journal
